[server]
hosts = 0.0.0.0:5232
max_connections = 10
max_content_length = 10000000
timeout = 30

[auth]
type = htpasswd
htpasswd_filename = /run/radicale/users
htpasswd_encryption = plain
delay = 1

[rights]
type = owner_only

[storage]
filesystem_folder = /var/lib/radicale/collections

[web]
type = none

[logging]
level = info
mask_passwords = true
