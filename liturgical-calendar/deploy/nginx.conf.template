server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json text/calendar;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = / {
        return 302 /divinum-officium/;
    }

    location = /divinum-officium {
        return 301 /divinum-officium/;
    }

    location /divinum-officium/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /divinum-officium/ {
        try_files $uri $uri/ /divinum-officium/index.html;
    }

    location = /api/translations {
        allow ${TRANSLATIONS_ALLOWED_IP};
        deny all;

        client_max_body_size 1m;
        proxy_pass http://translations-api:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /api/events {
        limit_except GET { deny all; }

        proxy_pass http://events-api:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /api/admin/capabilities {
        allow ${TRANSLATIONS_ALLOWED_IP};
        deny all;

        proxy_pass http://events-api:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/admin/events {
        allow ${TRANSLATIONS_ALLOWED_IP};
        deny all;

        client_max_body_size 1m;
        proxy_pass http://events-api:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ ^/api/admin/events/[A-Za-z0-9@._%-]+$ {
        allow ${TRANSLATIONS_ALLOWED_IP};
        deny all;

        client_max_body_size 1m;
        proxy_pass http://events-api:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /calendars/rubrics-1960-pt.ics {
        proxy_pass http://events-api:8091;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
    }
}
